# --- Supabase (required) ---------------------------------------------------
# Both NEXT_PUBLIC_* values ship to the browser. That is fine and expected:
# the anon key has zero table privileges (see supabase/migrations/002_lockdown.sql)
# and is used only for Realtime broadcast/presence.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Every database and storage operation runs through this key
# inside route handlers. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Optional --------------------------------------------------------------
# Signs the httpOnly room-unlock cookies. Defaults to SUPABASE_SERVICE_ROLE_KEY
# when unset; set it explicitly if you want to invalidate all unlock cookies
# without rotating the Supabase key. Generate with: openssl rand -base64 48
CLIPSYNC_AUTH_SECRET=

# Bearer token required by GET /api/cron/cleanup (the 7-day TTL purge).
# Without it the endpoint returns 503 and no rooms are ever cleaned up.
CRON_SECRET=

# App Site URL for metadata/OG tags
NEXT_PUBLIC_APP_URL=http://localhost:3000
