# --- Supabase (required) ---------------------------------------------------
# Both NEXT_PUBLIC_* values ship to the browser. That is fine and expected:
# the anon key has zero table privileges (see supabase/migrations/002_lockdown.sql)
# and is used only for Realtime broadcast/presence.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Every database and storage operation runs through this key
# inside route handlers. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Signs the httpOnly room-unlock cookies AND the owner capability cookies.
# Required, minimum 32 characters, and must NOT be the service-role key.
#
# It used to fall back to SUPABASE_SERVICE_ROLE_KEY. That is no longer allowed:
# this key is now what proves who created a room, and there is no account to
# recover from. Sharing it with the Supabase key means the next routine key
# rotation permanently orphans every room on the deployment at once.
#
#   openssl rand -base64 48
CLIPSYNC_AUTH_SECRET=

# --- Operator endpoints ----------------------------------------------------
# Bearer token required by every operator-only endpoint:
#   GET /api/cron/cleanup    the TTL purge and deletion worker
#   GET /api/cron/reconcile  DB/storage drift detection (report-only)
#   GET /api/health/ops      queue depth, last run, open findings
#
# Without it cleanup returns 503 and no room is ever deleted, which for a
# product that promises expiry is a broken promise rather than a missing
# feature. Set it, and alert on the cron having stopped (see docs/OPERATIONS.md).
#
#   openssl rand -base64 32
CRON_SECRET=

# --- Distributed rate limiting ---------------------------------------------
# Upstash Redis (or any REST-compatible endpoint speaking the same pipeline
# format). Optional locally; strongly recommended in production.
#
# Without it the limiter falls back to a per-process counter, which on
# serverless means the effective limit is the configured limit times the number
# of warm instances - a number nobody controls, that rises exactly when traffic
# rises, and that an attacker can raise on purpose. Against a 4-digit PIN that
# is not a limit.
#
# When these ARE set and Redis becomes unreachable, PIN verification and PIN
# changes refuse (503) rather than silently weakening; everything else falls
# back to the per-process limiter and logs the degradation. See docs/OPERATIONS.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 in production. Makes GET /api/health/ready fail while no shared
# limiter is configured, so a deploy without one cannot pass a deploy check.
CLIPSYNC_REQUIRE_DISTRIBUTED_LIMITER=

# --- Optional --------------------------------------------------------------

# App Site URL for metadata/OG tags
NEXT_PUBLIC_APP_URL=http://localhost:3000
